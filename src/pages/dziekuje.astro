---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getContent } from '../lib/content';
const content = await getContent();
---
<Layout content={content} title="Dziękuję za wiadomość" noindex>
  <Header settings={content.settings} />
  <main id="main" class="mx-auto max-w-page px-6 py-32">
    <p class="eyebrow">&gt; wiadomość wysłana</p>
    <h1 class="section-title mb-6">Dziękuję! Odezwę się w ciągu 24 godzin.</h1>
    <a href="/" class="btn-ghost">Wróć na stronę główną</a>
  </main>
  <Footer settings={content.settings} />
</Layout>
