---
import { serviceIcons, type Edit, type HomeContent } from '../data/site';
import { ed } from '../lib/content';
interface Props { services: HomeContent['services']; edit?: Edit }
const { services, edit } = Astro.props;
---
<section id="uslugi" class="border-t border-line">
  <div class="mx-auto max-w-page px-6 py-24">
    <p class="eyebrow" data-reveal>01 / usługi</p>
    <h2 class="section-title mb-14 max-w-[760px]" data-reveal style="--d: 80ms" {...ed(edit, 'uslugi_tytul')}>{services.title}</h2>
    <ul class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-5">
      {services.items.map((s, i) => (
        <li class="group rounded-card border border-line bg-surface p-8 transition-[transform,border-color,background-color] duration-300 hover:-translate-y-1.5 hover:border-line-strong hover:bg-surface-2" data-reveal style={`--d: ${i * 90}ms`} {...ed(s.edit)}>
          <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-accent transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-6" set:html={(serviceIcons[s.icon] ?? serviceIcons.okno).svg} />
          <h3 class="mt-5 mb-2.5 font-display text-[23px] font-bold text-ink" {...ed(s.edit, 'tytul')}>{s.title}</h3>
          <p class="text-muted" {...ed(s.edit, 'opis')}>{s.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
